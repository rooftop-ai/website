---
import AiLogo, { type AiBrand } from "./AiLogo.astro";
import { kern } from "../lib/typography";

// Illustrative examples of work AI handles in a property management
// operation, not customer data. Icons are Lucide paths (24x24, stroked).
const feed: { time: string; title: string; detail: string; icon: string[]; ai: AiBrand }[] = [
  {
    time: "2:14 AM",
    title: "Maintenance call answered",
    detail: "Leak in Unit 3 - plumber dispatched",
    ai: "chatgpt",
    icon: [
      "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z",
    ],
  },
  {
    time: "7:30 AM",
    title: "Notice of entry posted",
    detail: "Unit 12B - tenant notified 48 hours ahead",
    ai: "claude",
    icon: [
      "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
      "M2 9h20",
      "M6 6.5h.01",
      "M9 6.5h.01",
    ],
  },
  {
    time: "11:42 AM",
    title: "Vendor bill entered",
    detail: "Flagged: gas bill 3x the usual amount",
    ai: "claude",
    icon: [
      "M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z",
      "M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8",
      "M12 17.5v-11",
    ],
  },
];
---

<section class="hero" id="top">
  <svg class="hero-bands" viewBox="0 0 1200 520" aria-hidden="true" preserveAspectRatio="xMidYMin slice">
    <g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="56">
      <path d="M-60 520 600 80l660 440" stroke="var(--band-1)"></path>
      <path d="M-60 580 600 140l660 440" stroke="var(--band-2)"></path>
    </g>
  </svg>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">AI transformation for property management</p>
      <h1>
        <Fragment set:html={kern("Grow your door count,")} /> <span set:html={kern("not your headcount.")} />
      </h1>
      <p class="lede">
        We're your fractional Head of AI. We find where your team loses time, then put AI to work so you can grow.
      </p>
      <div class="actions">
        <a class="button button-primary" href="#contact">
          Book an assessment{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a class="button button-secondary" href="#approach">
          See how it works
        </a>
      </div>
    </div>

    <figure class="feed" aria-label="Example of the work AI handles in a day">
      <div class="feed-head">
        <span class="feed-live" aria-hidden="true"></span>
        <span class="feed-title">A day with AI on the team</span>
        <span class="feed-tag">Example</span>
      </div>
      <ol class="feed-list">
        {feed.map((item, i) => (
          <li style={`--i: ${i}`}>
            <span class="feed-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {item.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <span class="feed-ai" title={`Handled with ${item.ai === "claude" ? "Claude" : "ChatGPT"}`}>
                <AiLogo brand={item.ai} />
              </span>
            </span>
            <span class="feed-body">
              <span class="feed-item-title">{item.title}</span>
              <span class="feed-item-detail">{item.detail}</span>
            </span>
            <time class="feed-time">{item.time}</time>
          </li>
        ))}
      </ol>
      <figcaption class="feed-foot">
        <span>Hours back to your team</span>
        <strong>5 here, 8 there</strong>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 112px) clamp(72px, 10vw, 128px);
    background: linear-gradient(180deg, var(--paper-tint) 0%, var(--paper) 100%);
  }

  .hero-bands {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 78%;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .hero-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(38px, 5.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: var(--accent);
  }

  .lede {
    max-width: 580px;
    color: var(--ink-muted);
    font-size: clamp(18px, 1.7vw, 20px);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .feed {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .feed-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
  }

  .feed-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .feed-title {
    color: var(--heading);
    font-size: 15px;
    font-weight: 700;
  }

  .feed-tag {
    margin-left: auto;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--paper-tint);
    color: var(--ink-soft);
    font-size: 12px;
    font-weight: 600;
  }

  .feed-list {
    display: grid;
    margin: 0;
    padding: 8px 10px;
    list-style: none;
  }

  .feed-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 14px;
    padding: 12px;
    border-radius: 12px;
    animation: feed-in 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(250ms + var(--i) * 140ms);
  }

  .feed-list li + li {
    border-top: 1px solid var(--paper-tint);
  }

  .feed-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--surface-tint);
    border: 1px solid var(--surface-tint-line);
  }

  .feed-icon > svg {
    width: 22px;
    fill: none;
    stroke: var(--icon);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feed-ai {
    position: absolute;
    right: -7px;
    bottom: -7px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line),
      0 2px 6px var(--shadow-color);
  }

  .feed-ai :global(svg) {
    width: 14px;
    height: 14px;
  }

  .feed-body {
    display: grid;
    gap: 2px;
  }

  .feed-item-title {
    color: var(--ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
  }

  .feed-item-detail {
    color: var(--ink-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .feed-time {
    color: var(--ink-soft);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1.6;
  }

  .feed-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 22px;
    background: var(--panel);
    color: rgb(255 255 255 / 0.86);
    font-size: 14px;
    font-weight: 500;
  }

  .feed-foot strong {
    color: #fff;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 700;
  }

  @keyframes feed-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .feed {
      max-width: 560px;
    }
  }

  @media (max-width: 480px) {
    .actions,
    .actions .button {
      width: 100%;
    }

    .feed-list {
      padding: 6px;
    }

    .feed-list li {
      gap: 12px;
      padding: 12px 10px;
    }

    .feed-head,
    .feed-foot {
      padding-inline: 16px;
    }
  }
</style>
