---
import { Image } from "astro:assets";
import portrait from "../assets/nadaa-taiyab.webp";
import { site } from "../config/site";

const highlights = [
  { value: "1.8B+", label: "clinical notes de-identified by a pipeline she architected" },
  { value: "U.S. patent", label: "co-inventor on AI text processing" },
  { value: "2x", label: "McKesson Global Technology Award winner" },
  { value: "COO & CFO", label: "before AI, she ran the business side" },
];

const career = [
  "Founding Head of AI, Basata",
  "Principal Data Scientist, Tegria / Providence",
  "Senior Data Scientist, McKesson",
  "COO & CFO, Omedix",
  "Investment Banking, Goldman Sachs",
];

const education = [
  "B.A., summa cum laude, University of Pennsylvania",
  "M.A.L.D., The Fletcher School at Tufts University",
];
---

<section class="section founder" id="founder">
  <div class="container layout">
    <div class="aside">
      <div class="portrait">
        <Image
          src={portrait}
          alt="Nadaa Taiyab, founder of Rooftop Labs"
          widths={[360, 540, 720]}
          sizes="(max-width: 900px) 360px, 440px"
          loading="lazy"
        />
      </div>
      <div class="facts">
        <div>
          <h3>Career</h3>
          <ul>
            {career.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Education</h3>
          <ul>
            {education.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <header class="bio-head">
      <p class="eyebrow">Meet the founder</p>
      <h2>{site.founder.name}</h2>
      <p class="role">{site.founder.role}</p>
    </header>

    <div class="bio">
      <div class="prose">
        <p>
          Nadaa has spent a decade shipping production AI in demanding, regulated operations. At Providence, she helped
          launch the health system's generative AI practice and co-invented a patented pipeline that de-identified 1.8
          billion clinical notes. As Founding Head of AI at Basata, she built voice agents that cut referral wait times
          from two weeks to under 24 hours.
        </p>
        <p>
          Before AI, she was a COO and CFO, so she thinks in margins, not demos. She founded Rooftop Labs to bring
          enterprise-grade AI leadership to property management.
        </p>
      </div>

      <ul class="highlights">
        {highlights.map((h) => (
          <li>
            <strong>{h.value}</strong>
            <span>{h.label}</span>
          </li>
        ))}
      </ul>

      <a class="linkedin" href={site.founder.linkedin} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
        </svg>
        Connect with Nadaa on LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  /*
   * Desktop: a sticky portrait column beside the bio.
   * Narrow screens: the aside dissolves so the name comes first, then the
   * portrait, the story, and finally career and education facts.
   */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "aside head"
      "aside body";
    column-gap: clamp(40px, 6vw, 88px);
    row-gap: 26px;
  }

  .aside {
    grid-area: aside;
    align-self: start;
    display: grid;
    gap: 28px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .bio-head {
    grid-area: head;
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .portrait {
    grid-area: portrait;
    position: relative;
    max-width: 440px;
  }

  .portrait::before {
    content: "";
    position: absolute;
    inset: 18px -18px -18px 18px;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
  }

  .portrait :global(img) {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .facts {
    grid-area: facts;
    display: grid;
    gap: 20px;
    max-width: 440px;
    padding-top: 12px;
  }

  .facts h3 {
    margin-bottom: 8px;
    color: var(--ink-soft);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .facts ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
  }

  .bio {
    grid-area: body;
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .bio-head h2 {
    font-size: clamp(36px, 4.6vw, 52px);
  }

  .role {
    margin-top: -6px;
    color: var(--accent-text);
    font-size: 18px;
    font-weight: 700;
  }

  .prose {
    display: grid;
    gap: 18px;
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    width: 100%;
    margin: 18px 0 8px;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    list-style: none;
  }

  .highlights li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 20px 22px;
    background: var(--surface);
  }

  .highlights strong {
    color: var(--heading);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .highlights span {
    color: var(--ink-muted);
    font-size: 14.5px;
    line-height: 1.45;
  }

  .linkedin {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--heading);
    font-size: 16px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--green-400);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .linkedin:hover {
    text-decoration-color: var(--heading);
  }

  .linkedin svg {
    width: 20px;
    fill: light-dark(#0a66c2, #70b5f9);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        "head head"
        "portrait facts"
        "body body";
      align-items: end;
      row-gap: 36px;
    }

    .aside {
      display: contents;
    }

    .facts {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "portrait"
        "body"
        "facts";
      row-gap: 32px;
    }

    .portrait {
      max-width: 320px;
    }

    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
